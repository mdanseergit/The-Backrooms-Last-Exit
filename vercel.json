{
  "buildCommand": "pnpm --filter @workspace/last-exit run build",
  "outputDirectory": "artifacts/last-exit/dist/public",
  "installCommand": "npm install -g pnpm && pnpm install --frozen-lockfile --ignore-scripts",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets|favicon|robots|sitemap|manifest|api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
